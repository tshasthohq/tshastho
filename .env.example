# ===== Sentry (Item 24) =====
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ===== SSLCommerz (Item 23) =====
# Sandbox: SSLCOMMERZ_SANDBOX=true (default)
# Production: set to false + fill live credentials
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
# IPN (Instant Payment Notification) shared secret
SSLCOMMERZ_IPN_SECRET=
# Public app URL for callback success/fail/cancel URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
