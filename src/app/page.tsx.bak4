"use client";

import Link from "next/link";
import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import { 
  Stethoscope, Building2, Pill, TestTube, Ambulance, Droplets, 
  Home, Globe, ClipboardList, Activity, ShieldCheck, Video, Syringe, Search, Star, ArrowRight, Menu, X 
} from "lucide-react";
import { useBranding } from "@/hooks/useBranding";

export default function HomePage() {
  const { branding } = useBranding();
  const [menuOpen, setMenuOpen] = useState(false);
  const router = useRouter();
  const [query, setQuery] = useState("");
  const [topDoctors, setTopDoctors] = useState<any[]>([]);
  const [hotline, setHotline] = useState("");
  useEffect(() => {
    fetch("/api/settings/public")
      .then((r) => (r.ok ? r.json() : {}))
      .then((d: any) => setHotline(d.hotlineNumber || d.settings?.hotlineNumber || d.data?.hotlineNumber || ""))
      .catch(() => {});
  }, []);
  useEffect(() => {
    fetch("/api/doctors")
      .then((r) => (r.ok ? r.json() : []))
      .then((d) => {
        const list = Array.isArray(d) ? d : d.doctors || d.data || [];
        setTopDoctors(list);
      })
      .catch(() => {});
  }, []);
  const go = () => {
    const q = query.trim();
    router.push(q ? `/doctors?q=${encodeURIComponent(q)}` : "/doctors");
  };

  const services = [
    { title: "Doctors", icon: Stethoscope, desc: "Book Appointment", href: "/doctors" },
    { title: "Hospitals", icon: Building2, desc: "Find & Book", href: "/hospitals" },
    { title: "Pharmacies", icon: Pill, desc: "Buy Medicine", href: "/medicines" },
    { title: "Diagnostics", icon: TestTube, desc: "Book Tests", href: "/diagnostics" },
    { title: "Ambulance", icon: Ambulance, desc: "Emergency Ride", href: "/ambulance" },
    { title: "Blood Bank", icon: Droplets, desc: "Find Donors", href: "/blood-bank" },
    { title: "Home Care", icon: Home, desc: "Nursing & Care", href: "/home-care" },
    { title: "International", icon: Globe, desc: "Global Hospitals", href: "/international" },
    { title: "Packages", icon: ClipboardList, desc: "Checkup Offers", href: "/packages" },
    { title: "Equipment", icon: Activity, desc: "Rent or Buy", href: "/equipment" },
    { title: "Insurance", icon: ShieldCheck, desc: "Coverage Plans", href: "/insurance" },
    { title: "Telemedicine", icon: Video, desc: "Video Consult", href: "/telemedicine" },
    { title: "Vaccination", icon: Syringe, desc: "Book Vaccine", href: "/vaccination" },
  ];

  const doctors = [
    { name: "Dr. Sarah Mitchell", specialty: "Cardiologist", rating: 4.9, image: "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=300&h=300" },
    { name: "Prof. James Wilson", specialty: "Orthopedic", rating: 4.8, image: "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=300&h=300" },
    { name: "Dr. Aisha Rahman", specialty: "Neurologist", rating: 4.7, image: "https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&q=80&w=300&h=300" },
    { name: "Dr. Michael Chen", specialty: "Pediatrician", rating: 4.8, image: "https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=300&h=300" },
  ];

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans selection:bg-blue-200">
      
      {/* Premium Glassmorphism Navbar */}
      <nav className="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200/50 shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center gap-3 h-16 md:h-20">
            <div className="flex items-center gap-2">
              <img 
                src={branding.logo || "/logo.png"} 
                alt="Tshastho" 
                className="h-8 md:h-11 w-auto shrink min-w-0 object-contain" 
                onError={(e) => {
                  // যদি ছবি না পাওয়া যায়, তবে টেক্সট দেখাবে
                  e.currentTarget.style.display = 'none';
                  e.currentTarget.parentElement!.innerHTML += '<span class="text-2xl font-black text-slate-900 tracking-tighter">Tshastho</span>';
                }}
              />
            </div>
            <div className="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
              <Link href="/doctors" className="hover:text-blue-600 transition-colors">Find Doctors</Link>
              <Link href="/medicines" className="hover:text-blue-600 transition-colors">Pharmacy</Link>
              <Link href="/diagnostics" className="hover:text-blue-600 transition-colors">Diagnostics</Link>
            </div>
            <div className="flex items-center gap-1.5 md:gap-4 shrink-0">
              <Link href="/login" className="text-sm font-bold text-slate-600 hover:text-blue-600 transition-colors px-2 md:px-0">
                Log in
              </Link>
              <Link href="/register" className="bg-blue-600 text-white px-4 md:px-6 py-2 md:py-2.5 rounded-full text-sm font-bold shadow-lg shadow-blue-500/30 hover:bg-blue-700 hover:-translate-y-0.5 transition-all">
                Sign Up
              </Link>
              <button
                type="button"
                aria-label="Menu"
                onClick={() => setMenuOpen(!menuOpen)}
                className="md:hidden p-2 rounded-xl bg-slate-100 text-slate-700"
              >
                {menuOpen ? <X size={22} /> : <Menu size={22} />}
              </button>
            </div>
          </div>
          {menuOpen && (
            <div className="md:hidden pb-4 border-t border-slate-200/60">
              <div className="grid grid-cols-2 gap-2 pt-3">
                {[
                  ["Find Doctors", "/doctors"], ["Hospitals", "/hospitals"],
                  ["Pharmacy", "/medicines"], ["Diagnostics", "/diagnostics"],
                  ["Ambulance", "/ambulance"], ["Blood Bank", "/blood-bank"],
                  ["Telemedicine", "/telemedicine"], ["Home Care", "/home-care"],
                ].map(([label, href]) => (
                  <Link key={href} href={href} onClick={() => setMenuOpen(false)}
                    className="px-4 py-3 rounded-xl bg-slate-50 text-sm font-semibold text-slate-700 active:bg-blue-50">
                    {label}
                  </Link>
                ))}
              </div>
            </div>
          )}
        </div>
      </nav>

      {/* Hero Section */}
      <section className="relative pt-24 pb-10 md:pt-32 md:pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
        <div className="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl">
          <div className="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-200/50 rounded-full blur-3xl -z-10"></div>
          <div className="absolute top-40 left-0 w-[400px] h-[400px] bg-cyan-200/40 rounded-full blur-3xl -z-10"></div>
        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
          <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold mb-6">
            <span className="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
            Trusted Healthcare Platform
          </div>
          
          <h1 className="text-4xl md:text-6xl lg:text-7xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            All Your Healthcare <br className="hidden md:block"/>
            Needs in <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500">One Place</span>
          </h1>
          
          <p className="text-base md:text-xl text-slate-500 max-w-2xl mx-auto mb-6 md:mb-10 font-medium">
            Book doctors, order medicines, find hospitals, and more — from anywhere in Bangladesh and around the world.
          </p>

          <div className="max-w-3xl mx-auto bg-white rounded-2xl md:rounded-full shadow-2xl shadow-blue-500/10 p-2 flex flex-col md:flex-row gap-2 border border-slate-100">
            <div className="flex-1 flex items-center px-4 bg-slate-50 rounded-xl md:rounded-full">
              <Search className="text-slate-400 mr-2" size={20} />
              <input type="text" value={query} onChange={(e) => setQuery(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter") go(); }} placeholder="Search doctor or specialty..." 
                className="w-full py-3 bg-transparent focus:outline-none text-slate-700 placeholder-slate-400 font-medium" 
              />
            </div>
            <button onClick={go} className="bg-blue-600 text-white px-8 py-3.5 rounded-xl md:rounded-full w-full md:w-auto font-bold hover:bg-blue-700 transition-colors shadow-md">
              Search
            </button>
          </div>
          {/* QUICK_ACTIONS: shudhu mobile-e */}
          <div className="grid grid-cols-3 gap-3 max-w-md mx-auto mt-5 md:hidden">
            {[
              { label: "Doctors", href: "/doctors", Icon: Stethoscope, cls: "bg-blue-50 text-blue-600" },
              { label: "Pharmacy", href: "/medicines", Icon: Pill, cls: "bg-emerald-50 text-emerald-600" },
              { label: "Tests", href: "/diagnostics", Icon: TestTube, cls: "bg-violet-50 text-violet-600" },
            ].map(({ label, href, Icon, cls }) => (
              <Link key={href} href={href}
                className="flex flex-col items-center gap-2 py-4 rounded-2xl bg-white border border-slate-100 shadow-sm active:scale-95 transition">
                <span className={`w-11 h-11 rounded-xl flex items-center justify-center ${cls}`}><Icon size={22} /></span>
                <span className="text-xs font-bold text-slate-700">{label}</span>
              </Link>
            ))}
          </div>
        </div>
      </section>
      {/* Services Section */}
      <section className="py-10 md:py-20 bg-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-6 md:mb-16">
            <h2 className="text-2xl md:text-4xl font-black text-slate-900 mb-1 md:mb-3">Our Services</h2>
            <p className="text-slate-500 text-sm md:text-lg">Everything you need, in one place.</p>
          </div>
          
          <div className="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5 md:gap-5">
            {services.map((service, index) => {
              const Icon = service.icon;
              return (
                <Link 
                  href={service.href} 
                  key={index} 
                  className={`${index >= 12 ? "hidden md:flex " : ""}group bg-white p-3 md:p-6 rounded-2xl md:rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:shadow-blue-500/10 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center`}
                >
                  <div className="w-12 h-12 md:w-16 md:h-16 bg-blue-50 text-blue-600 rounded-xl md:rounded-2xl flex items-center justify-center mb-2 md:mb-4 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all duration-300">
                    <Icon size={26} strokeWidth={1.5} />
                  </div>
                  <h3 className="font-bold text-[11px] leading-tight md:text-base text-slate-800 md:mb-1">{service.title}</h3>
                  <p className="hidden md:block text-xs text-slate-500 font-medium">{service.desc}</p>
                </Link>
              );
            })}
          </div>
        </div>
      </section>

      {/* How It Works Section */}
      <section className="py-10 md:py-16 bg-slate-50 relative overflow-hidden">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="text-center mb-6 md:mb-12">
            <h2 className="text-2xl md:text-4xl font-black text-slate-900 mb-1 md:mb-3">How It Works</h2>
            <p className="text-slate-500 text-sm md:text-lg">Get your healthcare needs sorted in three simple steps.</p>
          </div>
          
          <div className="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-8">
            <div className="bg-white p-4 md:p-8 rounded-2xl md:rounded-3xl flex md:block items-center gap-4 text-left md:text-center shadow-sm border border-slate-100 text-center relative">
              <div className="w-14 h-14 md:w-20 md:h-20 shrink-0 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center md:mx-auto md:mb-6 shadow-inner">
                <Search size={26} strokeWidth={1.5} />
              </div>
              <div className="min-w-0"><h3 className="font-bold text-base md:text-xl text-slate-800 mb-1 md:mb-3">1. Search</h3><p className="text-slate-500 text-sm">Find the right doctor, hospital, or service near you with our smart search.</p></div>
            </div>
            <div className="bg-white p-4 md:p-8 rounded-2xl md:rounded-3xl flex md:block items-center gap-4 text-left md:text-center shadow-sm border border-slate-100 text-center relative">
              <div className="w-14 h-14 md:w-20 md:h-20 shrink-0 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center md:mx-auto md:mb-6 shadow-inner">
                <ClipboardList size={26} strokeWidth={1.5} />
              </div>
              <div className="min-w-0"><h3 className="font-bold text-base md:text-xl text-slate-800 mb-1 md:mb-3">2. Book</h3><p className="text-slate-500 text-sm">Choose a convenient date and time, and confirm your booking instantly.</p></div>
            </div>
            <div className="bg-white p-4 md:p-8 rounded-2xl md:rounded-3xl flex md:block items-center gap-4 text-left md:text-center shadow-sm border border-slate-100 text-center relative">
              <div className="w-14 h-14 md:w-20 md:h-20 shrink-0 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center md:mx-auto md:mb-6 shadow-inner">
                <Video size={26} strokeWidth={1.5} />
              </div>
              <div className="min-w-0"><h3 className="font-bold text-base md:text-xl text-slate-800 mb-1 md:mb-3">3. Consult</h3><p className="text-slate-500 text-sm">Visit the doctor or consult via secure video call right from your home.</p></div>
            </div>
          </div>
        </div>
      </section>
      {/* Top Doctors Section — real data */}
      {topDoctors.length > 0 && (
        <section className="py-10 md:py-20 bg-white">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="flex items-end justify-between mb-5 md:mb-12">
              <div>
                <h2 className="text-2xl md:text-4xl font-black text-slate-900 mb-1 md:mb-3">Our Doctors</h2>
                <p className="text-slate-500 text-sm md:text-lg">Consult with verified specialists.</p>
              </div>
              <Link href="/doctors" className="text-blue-600 font-bold flex items-center gap-1 text-sm md:text-base">
                View All <ArrowRight size={18} />
              </Link>
            </div>
            <div className="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-6 sm:overflow-visible">
              {topDoctors.slice(0, 8).map((doc: any, i: number) => {
                const name = (doc.user?.name || doc.name || "Doctor").trim();
                const spec = doc.specialty || doc.specialties?.[0]?.name || "";
                const img = doc.user?.avatarUrl || doc.user?.image || doc.image || "";
                const rating = Number(doc.averageRating ?? doc.rating);
                const verified = doc.verificationStatus === "VERIFIED";
                const exp = Number(doc.experience) || 0;
                return (
                  <Link
                    key={doc.id || i}
                    href={`/doctors/${doc.id}`}
                    className="snap-start shrink-0 w-[160px] sm:w-auto bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-lg transition-all"
                  >
                    <div className="relative h-32 sm:h-56 bg-gradient-to-br from-blue-50 to-emerald-50 flex items-center justify-center overflow-hidden">
                      {img ? (
                        <img src={img} alt={name} className="w-full h-full object-cover object-top" loading="lazy" />
                      ) : (
                        <span className="text-4xl font-black text-blue-300">{String(name).replace(/^Dr\.?\s*/i, "").charAt(0).toUpperCase()}</span>
                      )}
                      {rating > 0 && (
                        <div className="absolute top-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded-full text-xs font-bold text-slate-800 flex items-center gap-1 shadow-sm">
                          <Star size={12} className="text-yellow-500 fill-yellow-500" /> {rating.toFixed(1)}
                        </div>
                      )}
                    </div>
                    <div className="p-3 text-center">
                      <h3 className="font-bold text-sm text-slate-800 truncate">{name}</h3>
                      {spec && <p className="text-xs text-blue-600 font-semibold truncate">{spec}</p>}
                      {(verified || exp > 0) && (
                        <p className="mt-1 text-[11px] text-slate-500 flex items-center justify-center gap-1">
                          {verified && <span className="text-emerald-600 font-bold">✔ Verified</span>}
                          {exp > 0 && <span>· {exp} yrs</span>}
                        </p>
                      )}
                    </div>
                  </Link>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* Global Healthcare CTA */}
      <section className="py-24 bg-slate-900 relative overflow-hidden">
        <div className="absolute inset-0 opacity-20">
          <div className="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500 rounded-full blur-3xl -mr-40 -mt-40"></div>
          <div className="absolute bottom-0 left-0 w-[400px] h-[400px] bg-cyan-500 rounded-full blur-3xl -ml-20 -mb-20"></div>
        </div>
        
        <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
          <h2 className="text-3xl md:text-5xl font-black text-white mb-6">Global Healthcare Now at Your Fingertips</h2>
          <p className="text-slate-300 text-lg mb-10 max-w-2xl mx-auto">
            Book appointments with top doctors and hospitals from USA, UK, India, Malaysia, Singapore and more.
          </p>
          <Link href="/international" className="inline-flex items-center gap-2 bg-white text-slate-900 px-8 py-4 rounded-full font-bold text-lg hover:bg-blue-50 transition-colors shadow-xl">
            Explore International <ArrowRight size={20} />
          </Link>
        </div>
      </section>

      {/* Footer */}
      <footer className="bg-slate-950 text-slate-400 pt-10 pb-8 border-t border-slate-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-2 md:grid-cols-4 gap-8">
            <div className="col-span-2">
              <div className="flex items-center gap-2">
                {branding.logo ? (
                  <img src={branding.logo} alt="Tshastho" className="h-8 object-contain brightness-0 invert" />
                ) : (
                  <span className="text-2xl font-black text-white tracking-tight">Tshastho</span>
                )}
              </div>
              <p className="mt-3 text-sm max-w-sm">Connected Healthcare. Trusted Care. Book doctors, order medicines and find care across Bangladesh.</p>
              {hotline && (
                <a href={`tel:${hotline}`} className="mt-4 inline-block text-white font-bold text-sm">
                  Hotline: {hotline}
                </a>
              )}
            </div>
            <div>
              <h4 className="text-white font-bold text-sm mb-3">Explore</h4>
              <ul className="space-y-2 text-sm">
                {[{"l": "Doctors", "h": "/doctors"}, {"l": "Medicines", "h": "/medicines"}, {"l": "Diagnostics", "h": "/diagnostics"}, {"l": "Hospitals", "h": "/hospitals"}, {"l": "Blood Bank", "h": "/blood-bank"}, {"l": "Ambulance", "h": "/ambulance"}].map((x: any) => (
                  <li key={x.h}><Link href={x.h} className="hover:text-white">{x.l}</Link></li>
                ))}
              </ul>
            </div>
            <div>
              <h4 className="text-white font-bold text-sm mb-3">Company</h4>
              <ul className="space-y-2 text-sm">
                {[{"l": "About", "h": "/about"}, {"l": "Contact", "h": "/contact"}, {"l": "Privacy Policy", "h": "/privacy"}, {"l": "Terms of Service", "h": "/terms"}].map((x) => (
                  <li key={x.h}><Link href={x.h} className="hover:text-white">{x.l}</Link></li>
                ))}
              </ul>
            </div>
          </div>
          <div className="mt-8 pt-6 border-t border-slate-800 flex flex-col md:flex-row justify-between gap-2 text-sm text-center md:text-left">
            <p>© {new Date().getFullYear()} Tshastho. All rights reserved.</p>
            <p className="text-slate-500">Better Health, Brighter Tomorrow.</p>
          </div>
        </div>
      </footer>

    </div>
  );
}
