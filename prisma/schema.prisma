  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([doctorId, dayOfWeek])
  @@index([doctorId, isActive])
}

model DoctorLeave {
  id        String      @id @default(cuid())
  doctorId  String
  doctor    Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
