  @@index([linkedUserId])
}

model LocalPrescription {
  id                String              @id @default(cuid())
  prescriptionNo    String              @unique
  doctorId          String
  doctor            Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  localPatientId    String
