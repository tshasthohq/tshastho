// ============================================

enum ReturnType {
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE_WRITE_OFF
  EXPIRED_WRITE_OFF
}

enum ReturnStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum RefundMethod {
  CASH
  ORIGINAL
  STORE_CREDIT
  NO_REFUND
}

model ReturnOrder {
  id             String       @id @default(cuid())
  returnNumber   String
  pharmacyId     String
  pharmacy       Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  type           ReturnType
  status         ReturnStatus @default(PENDING)
  referenceId    String?
  referenceType  String?
  originalSaleId String?
  originalSale   PosSale?     @relation(fields: [originalSaleId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  customerName   String?
  customerPhone  String?
  totalAmount    Decimal      @default(0)
  refundMethod   RefundMethod @default(CASH)
  refundAmount   Decimal      @default(0)
