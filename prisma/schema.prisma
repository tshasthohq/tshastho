  patientId String
  patient   User     @relation("PatientFamilyHistory", fields: [patientId], references: [id], onDelete: Cascade)
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model DoctorPatientConsent {
