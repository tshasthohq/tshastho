generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
  DOCTOR
  PHARMACY_OWNER
  PHARMACY_STAFF
  DIAGNOSTIC_OWNER
  HOSPITAL_ADMIN
  PHARMA_COMPANY
  AMBULANCE_PROVIDER
  BLOOD_BANK_ADMIN
  MARKETING_MANAGER
  FIELD_EXECUTIVE
  DELIVERY_MAN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  sessions            Session[]
  auditLogs           AuditLog[]
  id                  String        @id @default(cuid())
  name                String?
  email               String        @unique
  phone               String?       @unique
  password            String
  role                Role
  status              AccountStatus @default(PENDING)
  isVerified          Boolean       @default(false)
  rejectReason        String?
  address             String?
  parentPharmacyId    String?
  staffRole           String?
  permissions         Json?
  basicSalary         Decimal       @default(0)
  dailyRate           Decimal       @default(0)
  commissionPercent   Decimal       @default(0)
  workingDaysPerMonth Int           @default(30)
  hoursPerDay         Int           @default(8)
  salaryType          String        @default("MONTHLY")
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  patientProfile        Patient?
  doctorProfile         Doctor?
  pharmacyProfile       Pharmacy?
  appointments          Appointment[]       @relation("PatientAppointments")
  notifications         Notification[]
  cartItems             CartItem[]
  patientOrders         Order[]             @relation("PatientOrders")
  attendances           Attendance[]
  salaryPayments        SalaryPayment[]
  staffAdvances         StaffAdvance[]
  payments              Payment[]           @relation("UserPayments")
  stockMovements        StockMovement[]     @relation("UserStockMovements")
  posSales              PosSale[]           @relation("StaffPosSales")
  posShifts             PosShift[]          @relation("StaffShifts")
  expensesCreated       PharmacyExpense[]   @relation("UserExpenses")
  expensesApproved      PharmacyExpense[]   @relation("ApprovedExpenses")
  ledgerEntries         PharmacyLedger[]    @relation("UserLedgerEntries")
  dailyClosings         DailyClosing[]      @relation("UserDailyClosings")
  dailyClosingsVer      DailyClosing[]      @relation("VerifiedDailyClosings")
  settlementsReq        SettlementRequest[] @relation("RequestedSettlements")
  settlementsApp        SettlementRequest[] @relation("ApprovedSettlements")
  patientPrescriptions  Prescription[]      @relation("PatientPrescriptions")
  doctorPrescriptions   Prescription[]      @relation("DoctorPrescriptions")
  verifiedPrescriptions Prescription[]      @relation("VerifiedPrescriptions")
  processedReturns      ReturnOrder[]       @relation("ProcessedReturns")
  approvedReturns       ReturnOrder[]       @relation("ApprovedReturns")
  loyalty               LoyaltyAccount?     @relation("UserLoyalty")
  doctorReferrals       DoctorReferral[]    @relation("DoctorReferrals")
  managedBranches       PharmacyBranch[]    @relation("BranchManager")
  requestedTransfers    BranchTransfer[]    @relation("RequestedTransfers")
  approvedTransfers     BranchTransfer[]    @relation("ApprovedTransfers")
  receivedTransfers     BranchTransfer[]    @relation("ReceivedTransfers")
  branchAssignments     BranchStaff[]       @relation("BranchStaffAssign")
  regulatoryLogs        RegulatoryLog[]     @relation("RegulatoryLogs")
  dgdaReports           DGDAReport[]        @relation("DGDAReports")
  verifiedDoctorDocs    DoctorDocument[]    @relation("VerifiedDoctorDocs")
  patientReviews        DoctorReview[]      @relation("PatientReviews")
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup  String?
  dateOfBirth DateTime?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Doctor {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty           String
  licenseNumber       String                   @unique
  experience          Int
  consultationFee     Decimal
  bookingPhone        String?
  chamberAddress      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  bio                 String?
  gender              DoctorGender?
  languages           String?
  hospitalAffiliation String?
  subSpecialties      String?
  onlineAvailable     Boolean                  @default(true)
  inPersonAvailable   Boolean                  @default(true)
  averageRating       Decimal                  @default(0)
  totalReviews        Int                      @default(0)
  verificationStatus  DoctorVerificationStatus @default(PENDING)
  appointments        Appointment[]            @relation("DoctorAppointments")
  specialties         DoctorSpecialty[]
  qualifications      DoctorQualification[]
  documents           DoctorDocument[]
  reviews             DoctorReview[]
  schedules           DoctorSchedule[]
  leaves              DoctorLeave[]
  slotOverrides       DoctorSlotOverride[]
}

model Pharmacy {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String
  logo            String?
  drugLicense     String              @unique
  tradeLicense    String
  address         String
  area            String?
  city            String
  deliveryRadius  Int                 @default(5)
  isOpen          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  medicines       Medicine[]
  orders          Order[]
  dues            Due[]
  attendances     Attendance[]
  salaryPayments  SalaryPayment[]
  staffAdvances   StaffAdvance[]
  batches         Batch[]
  stockMovements  StockMovement[]
  suppliers       Supplier[]
  purchases       PurchaseOrder[]
  posCustomers    PosCustomer[]
  posSales        PosSale[]
  posShifts       PosShift[]
  expenses        PharmacyExpense[]
  ledgerEntries   PharmacyLedger[]
  dailyClosings   DailyClosing[]
  settlements     SettlementRequest[]
  returns         ReturnOrder[]
  branches        PharmacyBranch[]
  branchTransfers BranchTransfer[]
  regulatoryLogs  RegulatoryLog[]
  dgdaReports     DGDAReport[]
}

model MasterMedicine {
  id           String     @id @default(cuid())
  name         String
  brand        String?
  genericName  String?
  strength     String?
  category     String?
  manufacturer String?
  imageUrl     String?
  description  String?
  createdAt    DateTime   @default(now())
  medicines    Medicine[]
}

model Medicine {
  id               String               @id @default(cuid())
  pharmacyId       String
  pharmacy         Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  masterMedicineId String?
  masterMedicine   MasterMedicine?      @relation(fields: [masterMedicineId], references: [id])
  name             String
  brand            String?
  genericName      String?
  category         String?
  description      String?
  purchasePrice    Decimal
  sellingPrice     Decimal
  discountPercent  Decimal              @default(0)
  stock            Int                  @default(0)
  unit             String               @default("piece")
  stripSize        Int                  @default(10)
  boxSize          Int                  @default(100)
  manufacturer     String?
  images           Json?
  expiryDate       DateTime?
  batchNumber      String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  cartItems        CartItem[]
  batches          Batch[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  posSaleItems     PosSaleItem[]
  returnItems      ReturnItem[]
  branchStocks     BranchStock[]
  regulatoryLogs   RegulatoryLog[]
  transferItems    BranchTransferItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  unitType   String   @default("piece")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique
  patientId          String
  patient            User          @relation("PatientOrders", fields: [patientId], references: [id])
  pharmacyId         String
  pharmacy           Pharmacy      @relation(fields: [pharmacyId], references: [id])
  totalAmount        Decimal
  platformFee        Decimal
  deliveryFee        Decimal       @default(0)
  discountAmount     Decimal       @default(0)
  finalAmount        Decimal
  totalCost          Decimal       @default(0)
  netProfit          Decimal       @default(0)
  status             String        @default("PENDING")
  deliveryAddress    String
  deliveryPhone      String
  receiverPhone      String?
  paymentMethod      String        @default("COD")
  paymentStatus      String        @default("PENDING")
  isPaid             Boolean       @default(false)
  isDue              Boolean       @default(false)
  paidAmount         Decimal       @default(0)
  dueAmount          Decimal       @default(0)
  prescriptionUrl    String?
  prescriptionStatus String        @default("NONE")
  prescriptionNote   String?
  notes              String?
  items              OrderItem[]
  payments           Payment[]
  commission         Commission?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  prescriptionId     String?
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId    String
  medicineName  String
  quantity      Int
  unitType      String   @default("piece")
  unitPrice     Decimal
  purchasePrice Decimal
  costPrice     Decimal  @default(0)
  subtotal      Decimal
  createdAt     DateTime @default(now())
}

model Due {
  id           String   @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patientId    String
  patientName  String
  patientPhone String
  amount       Decimal
  paidAmount   Decimal  @default(0)
  orderId      String?
  note         String?
  status       String   @default("UNPAID")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  date      String
  time      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor    Doctor   @relation("DoctorAppointments", fields: [doctorId], references: [id])
}

model Attendance {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId     String
  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime?
  checkInLat     String?
  checkInLng     String?
  checkInSelfie  String?
  checkOutSelfie String?
  checkOutLat    String?
  checkOutLng    String?
  totalHours     Decimal?
  date           String    @db.VarChar(10)
  status         String    @default("PRESENT")
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  category  String   @default("GENERAL")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, category])
}

model SalaryPayment {
  id                     String    @id @default(cuid())
  staffId                String
  staff                  User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  pharmacyId             String
  pharmacy               Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  month                  String    @db.VarChar(7)
  basicSalary            Decimal   @default(0)
  presentDays            Int       @default(0)
  totalDays              Int       @default(0)
  attendanceAmount       Decimal   @default(0)
  commissionAmount       Decimal   @default(0)
  bonus                  Decimal   @default(0)
  deduction              Decimal   @default(0)
  advanceDeducted        Decimal   @default(0)
  netPayable             Decimal   @default(0)
  paidAmount             Decimal   @default(0)
  status                 String    @default("PENDING")
  note                   String?
  paymentMethod          String    @default("CASH")
  paidAt                 DateTime?
  customAttendanceAmount Decimal?
  customCommissionAmount Decimal?
  customDeduction        Decimal?
  customNetPayable       Decimal?
  isCustomized           Boolean   @default(false)
  editNote               String?
  workingDaysThisMonth   Int       @default(30)
  hoursPerDayUsed        Int       @default(8)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model StaffAdvance {
  id              String   @id @default(cuid())
  staffId         String
  staff           User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  pharmacyId      String
  pharmacy        Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  amount          Decimal
  paidAmount      Decimal  @default(0)
  remainingAmount Decimal
  reason          String?
  status          String   @default("PENDING")
  givenAt         DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())
}

// ============================================
// PHASE 3: PAYMENT & FINANCE
// ============================================

enum PaymentStatus {
  INITIATED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  STRIPE
  CASH
  COD
  MANUAL
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum LedgerAccount {
  CUSTOMER
  PLATFORM
  PARTNER
  GATEWAY
  COMMISSION
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  ON_HOLD
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  userId          String
  user            User          @relation("UserPayments", fields: [userId], references: [id])
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  amount          Decimal
  currency        String        @default("BDT")
  status          PaymentStatus @default(INITIATED)
  method          PaymentMethod
  gatewayProvider String?
  gatewayTxnId    String?
  gatewayRefId    String?
  gatewayPayload  Json?
  failureReason   String?
  paidAt          DateTime?
  refundedAmount  Decimal       @default(0)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions  Transaction[]
  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([userId, status])
  @@index([gatewayTxnId])
  @@index([status, createdAt])
}

model Transaction {
  id          String          @id @default(cuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        TransactionType
  account     LedgerAccount
  amount      Decimal
  description String?
  referenceId String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([paymentId])
  @@index([account, createdAt])
}

model LedgerEntry {
  id            String        @id @default(cuid())
  paymentId     String?
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  debitAccount  LedgerAccount
  creditAccount LedgerAccount
  amount        Decimal
  currency      String        @default("BDT")
  description   String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([debitAccount, createdAt])
  @@index([creditAccount, createdAt])
}

model Refund {
  id           String    @id @default(cuid())
  refundNumber String    @unique
  paymentId    String
  payment      Payment   @relation(fields: [paymentId], references: [id])
  amount       Decimal
  reason       String?
  status       String    @default("PENDING")
  processedAt  DateTime?
  gatewayRefId String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([paymentId])
}

model Commission {
  id               String   @id @default(cuid())
  orderId          String?  @unique
  order            Order?   @relation(fields: [orderId], references: [id])
  partnerId        String?
  partnerType      String?
  orderAmount      Decimal
  commissionRate   Decimal
  commissionAmount Decimal
  partnerShare     Decimal
  status           String   @default("PENDING")
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([partnerId])
}

model Payout {
  id            String           @id @default(cuid())
  payoutNumber  String           @unique
  partnerId     String
  partnerType   String
  amount        Decimal
  currency      String           @default("BDT")
  status        SettlementStatus @default(PENDING)
  method        String?
  accountInfo   Json?
  scheduledAt   DateTime?
  processedAt   DateTime?
  failureReason String?
  metadata      Json?
  createdAt     DateTime         @default(now())

  @@index([partnerId, status])
}

model Settlement {
  id               String           @id @default(cuid())
  settlementNumber String           @unique
  partnerId        String
  partnerType      String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal
  commissionAmount Decimal
  netPayable       Decimal
  status           SettlementStatus @default(PENDING)
  payoutId         String?
  notes            String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([partnerId, status])
}

// ============================================
// PHASE 2A: BATCH, EXPIRY & STOCK MOVEMENT
// ============================================

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  OPENING
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model Batch {
  id            String    @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber   String
  mfgDate       DateTime?
  expiryDate    DateTime
  quantity      Int       @default(0)
  initialQty    Int       @default(0)
  purchasePrice Decimal
  sellingPrice  Decimal
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  isActive      Boolean   @default(true)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]

  @@index([pharmacyId, medicineId])
  @@index([expiryDate])
  @@index([pharmacyId, isActive, expiryDate])
}

model StockMovement {
  id            String            @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         Batch?            @relation(fields: [batchId], references: [id])
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?
  reason        String?
  userId        String?
  user          User?             @relation("UserStockMovements", fields: [userId], references: [id])
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([pharmacyId, createdAt])
  @@index([medicineId, createdAt])
  @@index([type, createdAt])
}

model Supplier {
  id            String   @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name          String
  companyName   String?
  phone         String
  email         String?
  address       String?
  contactPerson String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches   Batch[]
  purchases PurchaseOrder[]
  returns   ReturnOrder[]

  @@index([pharmacyId, isActive])
}

model PurchaseOrder {
  id             String         @id @default(cuid())
  purchaseNumber String
  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  status         PurchaseStatus @default(DRAFT)
  totalAmount    Decimal        @default(0)
  paidAmount     Decimal        @default(0)
  dueAmount      Decimal        @default(0)
  invoiceNumber  String?
  orderDate      DateTime       @default(now())
  receivedDate   DateTime?
  notes          String?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items PurchaseItem[]

  @@unique([pharmacyId, purchaseNumber])
  @@index([pharmacyId, status])
  @@index([supplierId])
}

model PurchaseItem {
  id          String        @id @default(cuid())
  purchaseId  String
  purchase    PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine      @relation(fields: [medicineId], references: [id])
  batchId     String?
  batch       Batch?        @relation(fields: [batchId], references: [id])
  batchNumber String
  mfgDate     DateTime?
  expiryDate  DateTime
  quantity    Int
  receivedQty Int           @default(0)
  unitCost    Decimal
  subtotal    Decimal
  createdAt   DateTime      @default(now())

  @@index([purchaseId])
  @@index([medicineId])
}

// ============================================
// PHASE 2B: POINT OF SALE (POS)
// ============================================

enum PosPaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  MIXED
  DUE
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

model PosCustomer {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name       String?
  phone      String?
  address    String?
  totalSpent Decimal  @default(0)
  visitCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales PosSale[]

  @@index([pharmacyId, phone])
}

model PosSale {
  id             String           @id @default(cuid())
  saleNumber     String
  pharmacyId     String
  pharmacy       Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       PosCustomer?     @relation(fields: [customerId], references: [id])
  customerName   String?
  customerPhone  String?
  staffId        String?
  staff          User?            @relation("StaffPosSales", fields: [staffId], references: [id])
  shiftId        String?
  shift          PosShift?        @relation(fields: [shiftId], references: [id])
  subtotal       Decimal          @default(0)
  discountAmount Decimal          @default(0)
  totalAmount    Decimal
  paidAmount     Decimal          @default(0)
  changeAmount   Decimal          @default(0)
  dueAmount      Decimal          @default(0)
  paymentMethod  PosPaymentMethod @default(CASH)
  notes          String?
  profit         Decimal          @default(0)
  isReturned     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items        PosSaleItem[]
  returnOrders ReturnOrder[]

  @@unique([pharmacyId, saleNumber])
  @@index([pharmacyId, createdAt])
  @@index([shiftId])
}

model PosSaleItem {
  id            String   @id @default(cuid())
  saleId        String
  sale          PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  medicineName  String
  quantity      Int
  unitPrice     Decimal
  purchasePrice Decimal  @default(0)
  discount      Decimal  @default(0)
  subtotal      Decimal
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([medicineId])
}

model PosShift {
  id           String         @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId      String
  staff        User           @relation("StaffShifts", fields: [staffId], references: [id])
  status       PosShiftStatus @default(OPEN)
  openingCash  Decimal        @default(0)
  closingCash  Decimal?
  expectedCash Decimal        @default(0)
  difference   Decimal        @default(0)
  totalSales   Decimal        @default(0)
  totalCash    Decimal        @default(0)
  totalCard    Decimal        @default(0)
  totalDigital Decimal        @default(0)
  totalDue     Decimal        @default(0)
  saleCount    Int            @default(0)
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  notes        String?

  sales PosSale[]

  @@index([pharmacyId, status])
  @@index([staffId, status])
}

// ============================================
// PHASE 2C: FINANCIAL LEDGER PER PHARMACY
// ============================================

enum ExpenseCategory {
  RENT
  SALARY
  UTILITY
  TRANSPORT
  PURCHASE
  MAINTENANCE
  MARKETING
  TAX
  MISC
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LedgerEntryType {
  SALE
  POS_SALE
  PURCHASE
  EXPENSE
  PAYMENT_RECEIVED
  REFUND
  SETTLEMENT
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum DailyClosingStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum SettlementRequestStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model PharmacyExpense {
  id           String          @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  amount       Decimal
  description  String
  receiptUrl   String?
  status       ExpenseStatus   @default(PENDING)
  expenseDate  DateTime        @default(now())
  createdById  String?
  createdBy    User?           @relation("UserExpenses", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?           @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  notes        String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pharmacyId, expenseDate])
  @@index([pharmacyId, status])
  @@index([pharmacyId, category])
}

model PharmacyLedger {
  id            String          @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  entryType     LedgerEntryType
  direction     LedgerDirection
  amount        Decimal
  balance       Decimal         @default(0)
  description   String?
  referenceId   String?
  referenceType String?
  createdById   String?
  createdBy     User?           @relation("UserLedgerEntries", fields: [createdById], references: [id])
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, entryType])
  @@index([referenceId])
}

model DailyClosing {
  id             String             @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  closingDate    DateTime
  status         DailyClosingStatus @default(DRAFT)
  openingCash    Decimal            @default(0)
  closingCash    Decimal            @default(0)
  expectedCash   Decimal            @default(0)
  difference     Decimal            @default(0)
  totalSales     Decimal            @default(0)
  totalPosSales  Decimal            @default(0)
  totalExpenses  Decimal            @default(0)
  totalPurchases Decimal            @default(0)
  totalCashIn    Decimal            @default(0)
  totalCashOut   Decimal            @default(0)
  netCashFlow    Decimal            @default(0)
  orderCount     Int                @default(0)
  posSaleCount   Int                @default(0)
  notes          String?
  closedById     String?
  closedBy       User?              @relation("UserDailyClosings", fields: [closedById], references: [id])
  verifiedById   String?
  verifiedBy     User?              @relation("VerifiedDailyClosings", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([pharmacyId, closingDate])
  @@index([pharmacyId, closingDate])
  @@index([pharmacyId, status])
}

model SettlementRequest {
  id               String                  @id @default(cuid())
  requestNumber    String
  pharmacyId       String
  pharmacy         Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  status           SettlementRequestStatus @default(REQUESTED)
  periodStart      DateTime
  periodEnd        DateTime
  grossSales       Decimal                 @default(0)
  commissionAmount Decimal                 @default(0)
  refundAmount     Decimal                 @default(0)
  netPayable       Decimal                 @default(0)
  requestedById    String?
  requestedBy      User?                   @relation("RequestedSettlements", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?                   @relation("ApprovedSettlements", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  completedAt      DateTime?
  payoutId         String?
  bankAccount      Json?
  notes            String?
  rejectionReason  String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([pharmacyId, requestNumber])
  @@index([pharmacyId, status])
  @@index([status, createdAt])
}

// ============================================
// PHASE 2D: PRESCRIPTION VERIFICATION
// ============================================

enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Prescription {
  id              String             @id @default(cuid())
  patientId       String
  patient         User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String?
  doctor          User?              @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  doctorName      String?
  doctorRegNo     String?
  hospitalName    String?
  prescriptionNo  String?
  issueDate       DateTime?
  imageUrl        String
  notes           String?
  diagnosis       String?
  status          PrescriptionStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?              @relation("VerifiedPrescriptions", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?
  validUntil      DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items  PrescriptionItem[]
  orders Order[]

  @@index([patientId, status])
  @@index([status, createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  strength       String?
  dosage         String?
  frequency      String?
  duration       String?
  quantity       Int?
  instructions   String?
  createdAt      DateTime     @default(now())

  @@index([prescriptionId])
}

// ============================================
// PHASE 2E: RETURNS & ADJUSTMENTS
// ============================================

enum ReturnType {
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE_WRITE_OFF
  EXPIRED_WRITE_OFF
}

enum ReturnStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum RefundMethod {
  CASH
  ORIGINAL
  STORE_CREDIT
  NO_REFUND
}

model ReturnOrder {
  id             String       @id @default(cuid())
  returnNumber   String
  pharmacyId     String
  pharmacy       Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  type           ReturnType
  status         ReturnStatus @default(PENDING)
  referenceId    String?
  referenceType  String?
  originalSaleId String?
  originalSale   PosSale?     @relation(fields: [originalSaleId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  customerName   String?
  customerPhone  String?
  totalAmount    Decimal      @default(0)
  refundMethod   RefundMethod @default(CASH)
  refundAmount   Decimal      @default(0)
  reason         String?
  notes          String?
  processedById  String?
  processedBy    User?        @relation("ProcessedReturns", fields: [processedById], references: [id])
  approvedById   String?
  approvedBy     User?        @relation("ApprovedReturns", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  processedAt    DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items ReturnItem[]

  @@unique([pharmacyId, returnNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, type])
}

model ReturnItem {
  id           String      @id @default(cuid())
  returnId     String
  return       ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine    @relation(fields: [medicineId], references: [id])
  batchId      String?
  batch        Batch?      @relation(fields: [batchId], references: [id])
  medicineName String
  quantity     Int
  unitPrice    Decimal     @default(0)
  subtotal     Decimal     @default(0)
  isRestocked  Boolean     @default(false)
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([returnId])
  @@index([medicineId])
}

// ============================================
// PHASE 2F: LOYALTY & REFERRAL
// ============================================

model LoyaltyAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("UserLoyalty", fields: [userId], references: [id], onDelete: Cascade)
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("BRONZE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions LoyaltyTransaction[]
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

model LoyaltyTransaction {
  id            String                 @id @default(cuid())
  accountId     String
  account       LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          LoyaltyTransactionType
  points        Int
  balance       Int
  referenceId   String?
  referenceType String?
  description   String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([accountId, createdAt])
}

model DoctorReferral {
  id             String   @id @default(cuid())
  doctorId       String
  doctor         User     @relation("DoctorReferrals", fields: [doctorId], references: [id], onDelete: Cascade)
  code           String   @unique
  commissionRate Decimal  @default(5)
  totalReferrals Int      @default(0)
  totalSales     Decimal  @default(0)
  totalEarned    Decimal  @default(0)
  totalPaid      Decimal  @default(0)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usages ReferralUsage[]

  @@index([doctorId])
}

model ReferralUsage {
  id               String         @id @default(cuid())
  referralId       String
  referral         DoctorReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  orderId          String?
  posSaleId        String?
  customerId       String?
  orderAmount      Decimal
  commissionAmount Decimal
  status           String         @default("PENDING")
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([referralId, createdAt])
  @@index([orderId])
}

// ============================================
// PHASE 2G: MULTI-BRANCH SUPPORT
// ============================================

model PharmacyBranch {
  id           String   @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String
  area         String?
  city         String?
  phone        String?
  managerId    String?
  manager      User?    @relation("BranchManager", fields: [managerId], references: [id])
  isActive     Boolean  @default(true)
  isMainBranch Boolean  @default(false)
  openingCash  Decimal  @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stocks       BranchStock[]
  transfersOut BranchTransfer[] @relation("TransferFrom")
  transfersIn  BranchTransfer[] @relation("TransferTo")
  staffAssign  BranchStaff[]

  @@unique([pharmacyId, code])
  @@index([pharmacyId, isActive])
}

model BranchStock {
  id           String         @id @default(cuid())
  branchId     String
  branch       PharmacyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity     Int            @default(0)
  reorderLevel Int            @default(10)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  @@unique([branchId, medicineId])
  @@index([branchId])
  @@index([medicineId])
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

model BranchTransfer {
  id             String         @id @default(cuid())
  transferNumber String
  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fromBranchId   String
  fromBranch     PharmacyBranch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       PharmacyBranch @relation("TransferTo", fields: [toBranchId], references: [id])
  status         TransferStatus @default(PENDING)
  reason         String?
  notes          String?
  requestedById  String?
  requestedBy    User?          @relation("RequestedTransfers", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?          @relation("ApprovedTransfers", fields: [approvedById], references: [id])
  receivedById   String?
  receivedBy     User?          @relation("ReceivedTransfers", fields: [receivedById], references: [id])
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items BranchTransferItem[]

  @@unique([pharmacyId, transferNumber])
  @@index([pharmacyId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model BranchTransferItem {
  id           String         @id @default(cuid())
  transferId   String
  transfer     BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine       @relation(fields: [medicineId], references: [id])
  medicineName String
  quantity     Int
  receivedQty  Int            @default(0)
  createdAt    DateTime       @default(now())

  @@index([transferId])
}

model BranchStaff {
  id       String         @id @default(cuid())
  branchId String
  branch   PharmacyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("BranchStaffAssign", fields: [userId], references: [id], onDelete: Cascade)
  role     String?
  isActive Boolean        @default(true)
  joinedAt DateTime       @default(now())
  leftAt   DateTime?

  @@unique([branchId, userId])
  @@index([userId, isActive])
}

// ============================================
// PHASE 2H: DGDA REGULATORY
// ============================================

enum DrugSchedule {
  OTC
  PRESCRIPTION
  NARCOTIC
  CONTROLLED
  ANTIBIOTIC
}

enum RegulatoryLogType {
  INWARD
  OUTWARD
  DISPOSAL
  TRANSFER
  ADJUSTMENT
  RETURN
}

model RegulatoryLog {
  id              String            @id @default(cuid())
  pharmacyId      String
  pharmacy        Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  logNumber       String
  logType         RegulatoryLogType
  medicineId      String
  medicine        Medicine          @relation(fields: [medicineId], references: [id])
  medicineName    String
  drugSchedule    DrugSchedule
  batchNumber     String?
  quantity        Int
  unit            String            @default("piece")
  supplierName    String?
  customerName    String?
  customerAddress String?
  doctorName      String?
  prescriptionNo  String?
  referenceId     String?
  referenceType   String?
  notes           String?
  reportedById    String?
  reportedBy      User?             @relation("RegulatoryLogs", fields: [reportedById], references: [id])
  entryDate       DateTime          @default(now())
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([pharmacyId, entryDate])
  @@index([pharmacyId, drugSchedule])
  @@index([medicineId])
}

model DGDAReport {
  id              String    @id @default(cuid())
  pharmacyId      String
  pharmacy        Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  reportNumber    String
  reportType      String
  periodStart     DateTime
  periodEnd       DateTime
  totalEntries    Int       @default(0)
  narcoticCount   Int       @default(0)
  controlledCount Int       @default(0)
  fileUrl         String?
  generatedById   String?
  generatedBy     User?     @relation("DGDAReports", fields: [generatedById], references: [id])
  submittedAt     DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([pharmacyId, createdAt])
}

enum DoctorVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DoctorDocumentType {
  LICENSE
  DEGREE
  CERTIFICATE
  NID
  PHOTO
  OTHER
}

enum DoctorGender {
  MALE
  FEMALE
  OTHER
}

model DoctorSpecialty {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([doctorId])
  @@index([name])
}

model DoctorQualification {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  degree      String
  institution String?
  year        Int?
  country     String?
  createdAt   DateTime @default(now())

  @@index([doctorId])
}

model DoctorDocument {
  id              String                   @id @default(cuid())
  doctorId        String
  doctor          Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  type            DoctorDocumentType
  title           String?
  fileUrl         String
  status          DoctorVerificationStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?                    @relation("VerifiedDoctorDocs", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([doctorId])
  @@index([status])
}

model DoctorReview {
  id           String   @id @default(cuid())
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId    String
  patient      User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  isPublic     Boolean  @default(true)
  isReported   Boolean  @default(false)
  reportReason String?
  createdAt    DateTime @default(now())

  @@unique([doctorId, patientId])
  @@index([doctorId, createdAt])
  @@index([rating])
}

// ============================================
// PHASE D2: SCHEDULE & AVAILABILITY
// ============================================

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SlotType {
  IN_PERSON
  ONLINE
  BOTH
}

model DoctorSchedule {
  id              String   @id @default(cuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek       WeekDay
  startTime       String
  endTime         String
  slotDuration    Int      @default(30)
  maxPatients     Int      @default(10)
  slotType        SlotType @default(IN_PERSON)
  chamberAddress  String?
  consultationFee Decimal?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
  @@index([doctorId, isActive])
}

model DoctorLeave {
  id        String      @id @default(cuid())
  doctorId  String
  doctor    Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(APPROVED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([doctorId, startDate])
  @@index([doctorId, status])
}

model DoctorSlotOverride {
  id              String   @id @default(cuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String
  endTime         String
  slotDuration    Int      @default(30)
  maxPatients     Int      @default(10)
  slotType        SlotType @default(IN_PERSON)
  chamberAddress  String?
  consultationFee Decimal?
  isBlocked       Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())

  @@index([doctorId, date])
}
