  medicineName    String
  strength        String?
  dosage          String?
  frequency       String?
  duration        String?
  quantity        Int?
  beforeAfterMeal String?
  route           String?
  unit            String?
  instructions    String?
  createdAt       DateTime     @default(now())

  @@index([prescriptionId])
}

