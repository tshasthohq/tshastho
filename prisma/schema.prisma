  @@index([status, createdAt])
}

// ============================================
// PHASE D6: LOCAL PRACTICE & CHAMBER
// ============================================

enum LocalPatientGender {
  MALE
  FEMALE
  OTHER
}

enum WalkInEarningStatus {
  RECORDED
  VOIDED
}

model DoctorChamber {
  id             String   @id @default(cuid())
