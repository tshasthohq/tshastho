// ============================================
// PHASE D2: SCHEDULE & AVAILABILITY
// ============================================

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SlotType {
  IN_PERSON
  ONLINE
  BOTH
}

model DoctorSchedule {
  id              String         @id @default(cuid())
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek       WeekDay
  startTime       String
  endTime         String
