  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([pharmacyId, createdAt])
  @@index([medicineId, createdAt])
  @@index([type, createdAt])
}

model Supplier {
  id            String   @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name          String
  companyName   String?
  phone         String
  email         String?
  address       String?
  contactPerson String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches            Batch[]
  purchases          PurchaseOrder[]
  returns            ReturnOrder[]
  SupplierCreditNote SupplierCreditNote[]

  @@index([pharmacyId, isActive])
}

model PurchaseOrder {
  id             String         @id @default(cuid())
  purchaseNumber String
  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  status         PurchaseStatus @default(DRAFT)
  totalAmount    Decimal        @default(0)
  paidAmount     Decimal        @default(0)
  dueAmount      Decimal        @default(0)
  invoiceNumber  String?
  orderDate      DateTime       @default(now())
  receivedDate   DateTime?
  notes          String?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items              PurchaseItem[]
  SupplierCreditNote SupplierCreditNote[]

  @@unique([pharmacyId, purchaseNumber])
  @@index([pharmacyId, status])
  @@index([supplierId])
}

model PurchaseItem {
  id          String        @id @default(cuid())
  purchaseId  String
  purchase    PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine      @relation(fields: [medicineId], references: [id])
  batchId     String?
  batch       Batch?        @relation(fields: [batchId], references: [id])
  batchNumber String
  mfgDate     DateTime?
  expiryDate  DateTime
  quantity    Int
  receivedQty Int           @default(0)
  unitCost    Decimal
  subtotal    Decimal
  createdAt   DateTime      @default(now())

  @@index([purchaseId])
  @@index([medicineId])
}

// ============================================
// PHASE 2B: POINT OF SALE (POS)
// ============================================

enum PosPaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  MIXED
  DUE
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

model PosCustomer {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name       String?
  phone      String?
  address    String?
  totalSpent Decimal  @default(0)
  visitCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales PosSale[]

  @@index([pharmacyId, phone])
}

model PosSale {
  id             String           @id @default(cuid())
  saleNumber     String
  pharmacyId     String
  pharmacy       Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       PosCustomer?     @relation(fields: [customerId], references: [id])
  customerName   String?
  customerPhone  String?
  staffId        String?
  staff          User?            @relation("StaffPosSales", fields: [staffId], references: [id])
  shiftId        String?
  shift          PosShift?        @relation(fields: [shiftId], references: [id])
  subtotal       Decimal          @default(0)
  discountAmount Decimal          @default(0)
  totalAmount    Decimal
  paidAmount     Decimal          @default(0)
  changeAmount   Decimal          @default(0)
  dueAmount      Decimal          @default(0)
  paymentMethod  PosPaymentMethod @default(CASH)
  notes          String?
  profit         Decimal          @default(0)
  isReturned     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items        PosSaleItem[]
  returnOrders ReturnOrder[]
  VatInvoice   VatInvoice?

  @@unique([pharmacyId, saleNumber])
  @@index([pharmacyId, createdAt])
  @@index([shiftId])
}

model PosSaleItem {
  id            String   @id @default(cuid())
  saleId        String
  sale          PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  medicineName  String
  quantity      Int
  unitPrice     Decimal
  purchasePrice Decimal  @default(0)
  discount      Decimal  @default(0)
  subtotal      Decimal
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([medicineId])
}

model PosShift {
  id           String         @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId      String
  staff        User           @relation("StaffShifts", fields: [staffId], references: [id])
  status       PosShiftStatus @default(OPEN)
  openingCash  Decimal        @default(0)
  closingCash  Decimal?
  expectedCash Decimal        @default(0)
  difference   Decimal        @default(0)
  totalSales   Decimal        @default(0)
  totalCash    Decimal        @default(0)
  totalCard    Decimal        @default(0)
  totalDigital Decimal        @default(0)
  totalDue     Decimal        @default(0)
  saleCount    Int            @default(0)
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  notes        String?

  sales PosSale[]

  @@index([pharmacyId, status])
  @@index([staffId, status])
}

// ============================================
// PHASE 2C: FINANCIAL LEDGER PER PHARMACY
// ============================================

enum ExpenseCategory {
  RENT
  SALARY
  UTILITY
  TRANSPORT
  PURCHASE
  MAINTENANCE
  MARKETING
  TAX
  MISC
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LedgerEntryType {
  SALE
  POS_SALE
  PURCHASE
  EXPENSE
  PAYMENT_RECEIVED
  REFUND
  SETTLEMENT
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum DailyClosingStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum SettlementRequestStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model PharmacyExpense {
  id           String          @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  amount       Decimal
  description  String
  receiptUrl   String?
  status       ExpenseStatus   @default(PENDING)
  expenseDate  DateTime        @default(now())
  createdById  String?
  createdBy    User?           @relation("UserExpenses", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?           @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  notes        String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pharmacyId, expenseDate])
  @@index([pharmacyId, status])
  @@index([pharmacyId, category])
}

model PharmacyLedger {
  id            String          @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  entryType     LedgerEntryType
  direction     LedgerDirection
  amount        Decimal
  balance       Decimal         @default(0)
  description   String?
  referenceId   String?
  referenceType String?
  createdById   String?
  createdBy     User?           @relation("UserLedgerEntries", fields: [createdById], references: [id])
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, entryType])
  @@index([referenceId])
}

model DailyClosing {
  id             String             @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  closingDate    DateTime
  status         DailyClosingStatus @default(DRAFT)
  openingCash    Decimal            @default(0)
  closingCash    Decimal            @default(0)
  expectedCash   Decimal            @default(0)
  difference     Decimal            @default(0)
  totalSales     Decimal            @default(0)
  totalPosSales  Decimal            @default(0)
  totalExpenses  Decimal            @default(0)
  totalPurchases Decimal            @default(0)
  totalCashIn    Decimal            @default(0)
  totalCashOut   Decimal            @default(0)
  netCashFlow    Decimal            @default(0)
  orderCount     Int                @default(0)
  posSaleCount   Int                @default(0)
  notes          String?
  closedById     String?
  closedBy       User?              @relation("UserDailyClosings", fields: [closedById], references: [id])
  verifiedById   String?
  verifiedBy     User?              @relation("VerifiedDailyClosings", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([pharmacyId, closingDate])
  @@index([pharmacyId, closingDate])
  @@index([pharmacyId, status])
}

model SettlementRequest {
  id               String                  @id @default(cuid())
  requestNumber    String
  pharmacyId       String
  pharmacy         Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  status           SettlementRequestStatus @default(REQUESTED)
  periodStart      DateTime
  periodEnd        DateTime
  grossSales       Decimal                 @default(0)
  commissionAmount Decimal                 @default(0)
  refundAmount     Decimal                 @default(0)
  netPayable       Decimal                 @default(0)
  requestedById    String?
  requestedBy      User?                   @relation("RequestedSettlements", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?                   @relation("ApprovedSettlements", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  completedAt      DateTime?
  payoutId         String?
  bankAccount      Json?
  notes            String?
  rejectionReason  String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([pharmacyId, requestNumber])
  @@index([pharmacyId, status])
  @@index([status, createdAt])
}

// ============================================
// PHASE 2D: PRESCRIPTION VERIFICATION
// ============================================

enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PrescriptionSource {
  UPLOADED
  DOCTOR_CREATED
}

model Prescription {
  id              String             @id @default(cuid())
  patientId       String
  patient         User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
