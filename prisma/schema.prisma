  @@index([doctorId, visitDate])
  @@index([localPatientId, visitDate])
  @@index([chamberId])
}

model WalkInEarning {
  id             String              @id @default(cuid())
  doctorId       String
  doctor         Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
