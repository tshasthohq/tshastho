  updatedAt    DateTime @updatedAt

  stocks       BranchStock[]
  transfersOut BranchTransfer[] @relation("TransferFrom")
  transfersIn  BranchTransfer[] @relation("TransferTo")
  staffAssign  BranchStaff[]

  @@unique([pharmacyId, code])
  @@index([pharmacyId, isActive])
}

model BranchStock {
  id           String         @id @default(cuid())
  branchId     String
  branch       PharmacyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity     Int            @default(0)
  reorderLevel Int            @default(10)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  @@unique([branchId, medicineId])
  @@index([branchId])
  @@index([medicineId])
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

model BranchTransfer {
  id             String         @id @default(cuid())
  transferNumber String
