  id           String    @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User      @relation("CustomerRefills", fields: [customerId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine  @relation(fields: [medicineId], references: [id])
  reminderDate DateTime
  reminderSent Boolean   @default(false)
  sentAt       DateTime?
  isDismissed  Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([pharmacyId, reminderDate])
  @@index([customerId, reminderDate])
}

// ============================================
// PHASE 2L: NARCOTIC REGISTER + EXPIRY AUTO-WRITE
// ============================================

enum ExpiryWriteOffStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model NarcoticRegister {
  id             String   @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  entryNumber    String
  medicineId     String
  medicine       Medicine @relation(fields: [medicineId], references: [id])
  medicineName   String
  batchNumber    String?
  direction      String // IN or OUT
  quantity       Int
  balance        Int      @default(0)
  patientName    String?
  patientAddress String?
  doctorName     String?
  doctorRegNo    String?
  prescriptionNo String?
  supplierName   String?
  notes          String?
  recordedById   String?
  recordedBy     User?    @relation("NarcoticRegisterEntries", fields: [recordedById], references: [id])
  entryDate      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([pharmacyId, entryNumber])
  @@index([pharmacyId, entryDate])
  @@index([medicineId])
}

model ExpiryWriteOffBatch {
  id           String               @id @default(cuid())
  batchId      String               @unique
  batch        Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pharmacyId   String
  pharmacy     Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine             @relation(fields: [medicineId], references: [id])
  quantity     Int
  reason       String               @default("EXPIRED")
  status       ExpiryWriteOffStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                @relation("ExpiryWriteOffReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  notes        String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([pharmacyId, status])
  @@index([pharmacyId, createdAt])
}

// ============================================
// PHASE 2M: CUSTOMER CREDIT LEDGER
// ============================================

enum CreditEntryType {
  SALE_ON_CREDIT
  PAYMENT_RECEIVED
  ADJUSTMENT
  WRITE_OFF
}

model CustomerCreditLedger {
  id            String          @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User            @relation("CustomerCreditEntries", fields: [customerId], references: [id], onDelete: Cascade)
  type          CreditEntryType
  amount        Decimal
  balance       Decimal         @default(0)
  referenceId   String?
  referenceType String?
  description   String?
  paymentMethod String?
  createdById   String?
  createdAt     DateTime        @default(now())
  Medicine      Medicine?       @relation(fields: [medicineId], references: [id])
  medicineId    String?

  @@index([pharmacyId, customerId])
  @@index([pharmacyId, createdAt])
}

// ============================================
// PHASE 2N: STAFF PERFORMANCE & PAYROLL
// ============================================

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model StaffPayroll {
  id               String        @id @default(cuid())
  pharmacyId       String
  pharmacy         Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId          String
  staff            User          @relation("StaffPayrollUser", fields: [staffId], references: [id], onDelete: Cascade)
  month            String
  basicSalary      Decimal       @default(0)
  presentDays      Int           @default(0)
  absentDays       Int           @default(0)
  leaveDays        Int           @default(0)
  workingDays      Int           @default(30)
  dailyRate        Decimal       @default(0)
  earnedBasic      Decimal       @default(0)
  commissionAmount Decimal       @default(0)
  bonus            Decimal       @default(0)
  overtime         Decimal       @default(0)
  deductions       Decimal       @default(0)
  advanceDeducted  Decimal       @default(0)
  netPayable       Decimal       @default(0)
  paidAmount       Decimal       @default(0)
  status           PayrollStatus @default(DRAFT)
  paidAt           DateTime?
  notes            String?
  approvedById     String?
  approvedBy       User?         @relation("StaffPayrollApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Medicine         Medicine?     @relation(fields: [medicineId], references: [id])
  medicineId       String?

  @@unique([pharmacyId, staffId, month])
  @@index([pharmacyId, month])
  @@index([staffId, month])
}

model StaffPerformance {
  id             String    @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId        String
  staff          User      @relation("StaffPerformanceUser", fields: [staffId], references: [id], onDelete: Cascade)
  month          String
  totalSales     Decimal   @default(0)
  totalOrders    Int       @default(0)
  avgOrderValue  Decimal   @default(0)
  totalCustomers Int       @default(0)
  posSaleCount   Int       @default(0)
  posSalesAmount Decimal   @default(0)
  calculatedAt   DateTime  @default(now())
  Medicine       Medicine? @relation(fields: [medicineId], references: [id])
  medicineId     String?

  @@unique([pharmacyId, staffId, month])
  @@index([pharmacyId, month])
}

model StaffTarget {
  id             String    @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId        String
  staff          User      @relation("StaffTargetUser", fields: [staffId], references: [id], onDelete: Cascade)
  month          String
  salesTarget    Decimal   @default(0)
  orderTarget    Int       @default(0)
  bonusOnAchieve Decimal   @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Medicine       Medicine? @relation(fields: [medicineId], references: [id])
  medicineId     String?

  @@unique([pharmacyId, staffId, month])
}

// ============================================
// PHASE D13: PREMIUM STAFF ATTENDANCE
// ============================================

model StaffShift {
  id           String        @id @default(cuid())
  staffId      String
  staff        DoctorStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  chamberId    String
  chamber      DoctorChamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  dayOfWeek    String
  startTime    String
  endTime      String
  graceMinutes Int           @default(10)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([staffId, isActive])
  @@index([chamberId, dayOfWeek])
}

model StaffAttendanceRule {
  id                String        @id @default(cuid())
  chamberId         String        @unique
  chamber           DoctorChamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  radiusMeters      Int           @default(200)
  workingHoursStart String        @default("09:00")
  workingHoursEnd   String        @default("18:00")
  lateGraceMinutes  Int           @default(10)
  requireSelfie     Boolean       @default(true)
  requireGps        Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ============================================
// PHASE 2P: SMS & WHATSAPP
// ============================================

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BLOCKED
}

enum SmsProvider {
  SSL_WIRELESS
  TWILIO
  BANGLALINK
  MANUAL
}

model SmsLog {
  id            String      @id @default(cuid())
  pharmacyId    String?
  pharmacy      Pharmacy?   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?       @relation("CustomerSmsLogs", fields: [customerId], references: [id])
  recipientName String?
  phone         String
  message       String      @db.Text
  templateKey   String?
  provider      SmsProvider @default(MANUAL)
  status        SmsStatus   @default(QUEUED)
  providerRefId String?
  failureReason String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  metadata      Json?
  createdById   String?
  createdBy     User?       @relation("SmsLogCreator", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  Medicine      Medicine?   @relation(fields: [medicineId], references: [id])
  medicineId    String?

  @@index([pharmacyId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([phone])
}

model SmsTemplate {
  id         String    @id @default(cuid())
  pharmacyId String?
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  key        String
  name       String
  language   String    @default("bn")
  body       String    @db.Text
  isActive   Boolean   @default(true)
  isSystem   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Medicine   Medicine? @relation(fields: [medicineId], references: [id])
  medicineId String?

  @@unique([pharmacyId, key, language])
  @@index([pharmacyId, isActive])
}

// ============================================
// PHASE 2Q: SPLIT PAYMENTS
// ============================================

model PaymentSplit {
  id            String   @id @default(cuid())
  referenceId   String // orderId or posSaleId
  referenceType String // ORDER or POS_SALE
  method        String // CASH, BKASH, NAGAD, CARD, CREDIT, DUE
  amount        Decimal
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([referenceId, referenceType])
  @@index([method])
}

// ============================================
// PHASE 2S: PRESCRIPTION → PHARMACY REQUEST
// ============================================

enum RxPharmacyRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONVERTED
  CANCELLED
}

model RxPharmacyRequest {
  id                  String                  @id @default(cuid())
  requestNumber       String                  @unique
  prescriptionId      String?
  prescription        Prescription?           @relation(fields: [prescriptionId], references: [id])
  localPrescriptionId String?
  localPrescription   LocalPrescription?      @relation(fields: [localPrescriptionId], references: [id])
  patientId           String
  patient             User                    @relation("PatientRxRequests", fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyId          String
  pharmacy            Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  status              RxPharmacyRequestStatus @default(PENDING)
  orderId             String?                 @unique
  order               Order?                  @relation(fields: [orderId], references: [id])
  notes               String?
  rejectionReason     String?
  respondedById       String?
  respondedBy         User?                   @relation("RxRequestResponder", fields: [respondedById], references: [id])
  respondedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  Medicine            Medicine?               @relation(fields: [medicineId], references: [id])
  medicineId          String?

  @@index([pharmacyId, status])
  @@index([patientId, status])
  @@index([prescriptionId])
}

// ============================================
// PHASE 2T: DRUG INTERACTION CHECKER
// ============================================

enum InteractionSeverity {
  MINOR
  MODERATE
  MAJOR
  CONTRAINDICATED
}

model DrugInteraction {
  id             String              @id @default(cuid())
  drug1Name      String
  drug1Generic   String?
  drug2Name      String
  drug2Generic   String?
  severity       InteractionSeverity @default(MODERATE)
  description    String              @db.Text
  recommendation String?             @db.Text
  source         String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())

  @@index([drug1Name])
  @@index([drug2Name])
  @@index([drug1Generic])
  @@index([drug2Generic])
}

model PrescriptionInteractionCheck {
  id               String              @id @default(cuid())
  prescriptionId   String
  prescription     Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  interactionId    String?
  drug1Name        String
  drug2Name        String
  severity         InteractionSeverity
  description      String?             @db.Text
  wasAcknowledged  Boolean             @default(false)
  acknowledgedById String?
  acknowledgedBy   User?               @relation("InteractionAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  notes            String?
  createdAt        DateTime            @default(now())

  @@index([prescriptionId])
  @@index([severity])
}

// ============================================
// PHASE 2U: TAX / VAT REPORT
// ============================================

enum VatReportStatus {
  DRAFT
  FINALIZED
  SUBMITTED
  REVISED
}

model TaxConfiguration {
  id                String   @id @default(cuid())
  pharmacyId        String   @unique
  pharmacy          Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  isVatRegistered   Boolean  @default(false)
  vatNumber         String?
  tinNumber         String?
  businessName      String?
  businessAddress   String?
  vatRate           Decimal  @default(15)
  enableVatOnPos    Boolean  @default(false)
  enableVatOnOnline Boolean  @default(false)
  invoicePrefix     String   @default("INV")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VatInvoice {
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  pharmacyId        String
  pharmacy          Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderId           String?   @unique
  order             Order?    @relation(fields: [orderId], references: [id])
  posSaleId         String?   @unique
  posSale           PosSale?  @relation(fields: [posSaleId], references: [id])
  customerName      String?
  customerPhone     String?
  customerVatNumber String?
  subtotal          Decimal   @default(0)
  discount          Decimal   @default(0)
  vatRate           Decimal   @default(0)
  vatAmount         Decimal   @default(0)
  totalAmount       Decimal   @default(0)
  invoiceDate       DateTime  @default(now())
  isCancelled       Boolean   @default(false)
  cancelledAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())

  @@index([pharmacyId, invoiceDate])
  @@index([pharmacyId, isCancelled])
}

model VatReport {
  id             String          @id @default(cuid())
  reportNumber   String          @unique
  pharmacyId     String
  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  month          String
  periodStart    DateTime
  periodEnd      DateTime
  totalSales     Decimal         @default(0)
  totalDiscount  Decimal         @default(0)
  totalVat       Decimal         @default(0)
  totalInvoices  Int             @default(0)
  cancelledCount Int             @default(0)
  vatNumber      String?
  status         VatReportStatus @default(DRAFT)
  generatedById  String?
  generatedBy    User?           @relation("VatReportGenerator", fields: [generatedById], references: [id])
  submittedAt    DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([pharmacyId, month])
  @@index([pharmacyId, createdAt])
}

// ============================================
// PHASE 2W: PHARMACY AUDIT LOG
// ============================================

model PharmacyAuditLog {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("PharmacyAuditUser", fields: [userId], references: [id])
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  severity   String   @default("INFO")
  createdAt  DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, action])
  @@index([userId, createdAt])
}

// ============================================
// PHASE 2X: SUPPLIER CREDIT NOTES
// ============================================

enum SupplierCreditStatus {
  ISSUED
  PARTIALLY_APPLIED
  APPLIED
  VOIDED
}

model SupplierCreditNote {
  id                 String               @id @default(cuid())
  creditNumber       String               @unique
  pharmacyId         String
  pharmacy           Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  returnOrderId      String?              @unique
  returnOrder        ReturnOrder?         @relation(fields: [returnOrderId], references: [id])
  originalPurchaseId String?
  originalPurchase   PurchaseOrder?       @relation(fields: [originalPurchaseId], references: [id])
  amount             Decimal
  appliedAmount      Decimal              @default(0)
  balance            Decimal              @default(0)
  status             SupplierCreditStatus @default(ISSUED)
  notes              String?
  issuedById         String?
  issuedBy           User?                @relation("SupplierCreditIssuer", fields: [issuedById], references: [id])
  issuedAt           DateTime             @default(now())
  voidedAt           DateTime?
  voidedReason       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, status])
  @@index([supplierId, status])
}

// ============================================
// PHASE 2Z: PRESCRIPTION OCR
// ============================================

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

model PrescriptionOcrJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("UserOcrJobs", fields: [userId], references: [id], onDelete: Cascade)
  imageUrl       String
  extractedText  String?   @db.Text
  extractedItems Json?
  status         OcrStatus @default(PENDING)
  provider       String    @default("MANUAL")
  confidence     Decimal   @default(0)
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ============================================
// ITEM 6: WHATSAPP LOG
// ============================================

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppProvider {
  META
  TWILIO
  MANUAL
}

model WhatsAppLog {
  id            String           @id @default(cuid())
  pharmacyId    String?
  pharmacy      Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?            @relation("CustomerWhatsAppLogs", fields: [customerId], references: [id])
  recipientName String?
  phone         String
  message       String?          @db.Text
  templateName  String?
  templateData  Json?
  provider      WhatsAppProvider @default(MANUAL)
  status        WhatsAppStatus   @default(QUEUED)
  providerRefId String?
  failureReason String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  metadata      Json?
  createdById   String?
  createdBy     User?            @relation("WhatsAppLogCreator", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([pharmacyId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([phone])
}
