  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fromBranchId   String
  fromBranch     PharmacyBranch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       PharmacyBranch @relation("TransferTo", fields: [toBranchId], references: [id])
  status         TransferStatus @default(PENDING)
  reason         String?
  notes          String?
  requestedById  String?
  requestedBy    User?          @relation("RequestedTransfers", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?          @relation("ApprovedTransfers", fields: [approvedById], references: [id])
  receivedById   String?
  receivedBy     User?          @relation("ReceivedTransfers", fields: [receivedById], references: [id])
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items BranchTransferItem[]

  @@unique([pharmacyId, transferNumber])
  @@index([pharmacyId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model BranchTransferItem {
  id           String         @id @default(cuid())
  transferId   String
  transfer     BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
