  doctor          User?              @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  doctorName      String?
  doctorRegNo     String?
  hospitalName    String?
  prescriptionNo  String?
  issueDate       DateTime?
  imageUrl        String
  notes           String?
  diagnosis       String?
  source          PrescriptionSource @default(UPLOADED)
  appointmentId   String?
  chiefComplaint  String?
  examination     String?
  investigations  String?
  advice          String?
  followUpDate    String?
  followUpNotes   String?
  prescriptionPdf String?
  status          PrescriptionStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?              @relation("VerifiedPrescriptions", fields: [verifiedById], references: [id])
