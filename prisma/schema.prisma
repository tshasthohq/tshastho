  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum HistoryType {
  CONDITION
  SURGERY
  HOSPITALIZATION
  PROCEDURE
}

enum ConsentScope {
  FULL_HISTORY
  SPECIFIC_REPORTS
  CURRENT_VISIT
  PRESCRIPTIONS_ONLY
}

enum ConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

model PatientAllergy {
  id        String          @id @default(cuid())
  patientId String
  patient   User            @relation("PatientAllergies", fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  type      String          @default("DRUG")
